# ============================================================
#  自托管私有 AI 网关套件 —— 环境变量模板
#  Self-hosted private AI gateway kit — env template
#  用法:cp .env.example .env 然后改下面的值。  .env 不要提交到 git。
#  Usage: cp .env.example .env then edit. NEVER commit your .env.
# ============================================================

# ---- 镜像 / Images ----
CLIPROXY_IMAGE=eceasy/cli-proxy-api:latest
WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
MIHOMO_IMAGE=metacubex/mihomo:latest

# ---- 端口(宿主)/ Host ports ----
CLIPROXY_PORT=8317
WEBUI_PORT=3000

# ---- 数据 / Data root(挂载卷的本地根目录)----
DATA_ROOT=./data

# ---- 密钥:自己生成强随机值,切勿用示例值 / Secrets: generate your own ----
# 客户端调用 /v1 用的 key(Authorization: Bearer ...)
CLIPROXY_API_KEY=sk-CHANGE-ME-to-a-long-random-string
# CLIProxyAPI 管理后台密钥
CLIPROXY_MGMT_SECRET=CHANGE-ME-to-a-long-random-string

# ---- 出站代理:访问国外上游(OpenAI/Anthropic/Google)用 ----
# ---- Outbound proxy for reaching overseas AI upstreams ----
# 用内置 mihomo:http://mihomo:7890 ;若你已有代理,填它的地址
OUTBOUND_PROXY_URL=http://mihomo:7890

# ---- 公网入口(可选,用 Cloudflare 隧道时填)/ Public ingress (optional) ----
WEBUI_HOSTNAME=chat.example.com
API_HOSTNAME=api.example.com
# Cloudflare 隧道 token(在 Cloudflare Zero Trust 后台生成)
CLOUDFLARE_TUNNEL_TOKEN=
# 允许登录 Web 界面的邮箱(Cloudflare Access 策略用),逗号分隔
ACCESS_ALLOWED_EMAILS=you@example.com
